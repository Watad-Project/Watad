# Copy this file to .env (git ignores .env) and fill in the real values.
# Ask Ameer or Omar Mulla for them.
#
# .env is bundled into the app, so anyone can read it from the APK/IPA.
# Put only public values here: the Supabase URL and the publishable (anon) key.
# Never the secret key, the service role key or a blockchain key.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
