# Copy this file to .env (git ignores .env) and fill in the real values.
# Ask Ameer or Omar Mulla for them.
#
# .env is bundled into the app, so anyone can read it from the APK/IPA.
# Put only public values here: the Supabase URL, the publishable (anon) key
# and the OneSignal App ID. Never the secret key, the service role key, a
# blockchain key or the OneSignal REST API key.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Push notifications (optional: without it the app runs without push).
ONESIGNAL_APP_ID=your-onesignal-app-id
